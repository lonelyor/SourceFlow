							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Do not let third-party sync software sync the workspace directly."
								}
							]
						}
					]
				},
				{
					"ID": "2026040219600125-g0125",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "2026040219600126-g0126",
						"updated": "20260402193000"
					},
					"Children": [
						{
							"ID": "2026040219600111-g0111",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "2026040219600112-g0112",
								"updated": "20260402193000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "One workspace should stick to one remote backup directory. Do not switch back and forth."
								}
							]
						}
					]
				},
				{
					"ID": "2026040219600127-g0127",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
						"id": "2026040219600128-g0128",
						"updated": "20260402193000"
					},
					"Children": [
						{
							"ID": "2026040219600113-g0113",
							"Type": "NodeParagraph",
							"Properties": {
								"id": "2026040219600114-g0114",
								"updated": "20260402193000"
							},
							"Children": [
								{
									"Type": "NodeText",
									"Data": "Sync multiple devices alternately instead of concurrently."
								}
							]
						}
					]
				},
				{
					"ID": "2026040219600129-g0129",
					"Type": "NodeListItem",
					"ListData": {
						"BulletChar": 42,
						"Marker": "Kg=="
					},
					"Properties": {
