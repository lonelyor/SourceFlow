{
	"ID": "20230805231614-vqn28eh",
	"Spec": "2",
	"Type": "NodeDocument",
	"Properties": {
		"icon": "1f4be",
		"id": "20230805231614-vqn28eh",
		"title": "Backup and Sync System",
		"type": "doc",
		"updated": "20260421194000"
	},
	"Children": [
		{
			"ID": "20260421194010-sync01",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194010-sync01",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "SourceFlow uses one backup and sync system for full-directory backup, self-hosted sync, and restore workflows. The practical rule is simple: back up first, sync second, restore only when needed."
				}
			]
		},
		{
			"ID": "20260421194010-sync02",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194010-sync02",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Start by deciding whether you need single-device backup or multi-device sync. For a single machine or NAS, read the full-directory and Local File System backup chapters first. For multi-device collaboration, continue with self-hosted sync and providers such as Cloudflare R2, S3, or WebDAV."
				}
			]
		},
		{
			"ID": "20260421194010-sync03",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194010-sync03",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Before a restore, migration, or large cleanup, make a fresh full-directory backup. That is the safest default workflow."
				}
			]
		},
		{
			"ID": "2026040219500001-g0001",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "2026040219500002-g0002",
				"updated": "20260402193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The current portable build does not require registration, login, or payment. Notes, import/export, marketplace, and self-hosted sync/restore backup are all available directly."
				}
			]
		},
		{
			"ID": "2026040219500003-g0003",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "2026040219500004-g0004",
				"updated": "20260402193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "Recommended reading order:"
				}
			]
		},
