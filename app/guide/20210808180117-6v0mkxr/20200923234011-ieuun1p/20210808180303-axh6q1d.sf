					"TextMarkTextContent": "Theme"
				}
			]
		},
		{
			"ID": "20260421194009-appen02",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194009-appen02",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "In "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Settings"
				},
				{
					"Type": "NodeText",
					"Data": " - "
				},
				{
					"Type": "NodeTextMark",
					"TextMarkType": "kbd",
					"TextMarkTextContent": "Appearance"
				},
				{
					"Type": "NodeText",
					"Data": ", you can configure the mascot and Startup Page Image. The mascot supports local image import, position, visual effects, plus hide and wake controls during runtime; the startup page image supports local files or remote URLs with opacity and blur controls."
				}
			]
		},
		{
			"ID": "20260421194009-appen03",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194009-appen03",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "The same appearance area also lets you configure the note background image and a custom cursor. Both stay in the presentation layer and do not rewrite the document content."
				}
			]
		},
		{
			"ID": "20260421194009-appen04",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194009-appen04",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "When you import local images for the mascot, startup page, note background, or cursor, SourceFlow stores them as embedded assets so the setup does not depend on the original file path."
				}
			]
		}
	]
}
