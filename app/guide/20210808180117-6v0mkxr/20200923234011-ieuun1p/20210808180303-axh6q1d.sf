	},
	"Children": [
		{
			"ID": "20260421194009-appen01",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194009-appen01",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "SourceFlow note appearance goes beyond themes and icons. You can personalize the workspace with a mascot, startup page image, note background, and custom cursor without changing the note content itself."
				}
			]
		},
		{
			"ID": "20240508004341-z4ugefi",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20240508004341-z4ugefi",
				"updated": "20260421194000"
			},
			"Children": [
