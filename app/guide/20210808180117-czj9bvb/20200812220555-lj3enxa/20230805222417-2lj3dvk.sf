{
	"ID": "20230805222417-2lj3dvk",
	"Spec": "2",
	"Type": "NodeDocument",
	"Properties": {
		"icon": "1f4be",
		"id": "20230805222417-2lj3dvk",
		"title": "备份同步系统",
		"type": "doc",
		"updated": "20260421194000"
	},
	"Children": [
		{
			"ID": "20260421194005-sync01",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194005-sync01",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "源流的备份同步系统把整目录备份、自托管同步与恢复放在同一套数据安全流程里，重点是先备份，再同步，再恢复。"
				}
			]
		},
		{
			"ID": "20260421194005-sync02",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194005-sync02",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "建议先判断自己是单机备份还是多端同步：单机或 NAS 场景优先看整目录备份、本地文件系统备份；多端协作再看自托管同步与恢复，以及 Cloudflare R2 / S3 / WebDAV 等路径。"
				}
			]
		},
		{
			"ID": "20260421194005-sync03",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "20260421194005-sync03",
				"updated": "20260421194000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "执行恢复、迁移或大规模整理前，先做一次整目录备份，会比事后补救更稳。"
				}
			]
		},
		{
			"ID": "2026040219300001-g0001",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "2026040219300002-g0002",
				"updated": "20260402193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "当前绿色版无需注册、登录或付费，笔记编辑、导入导出、集市、自托管同步与恢复备份都可以直接使用。"
				}
			]
		},
		{
			"ID": "2026040219300003-g0003",
			"Type": "NodeParagraph",
			"Properties": {
				"id": "2026040219300004-g0004",
				"updated": "20260402193000"
			},
			"Children": [
				{
					"Type": "NodeText",
					"Data": "推荐先阅读下面几篇："
				}
			]
		},
