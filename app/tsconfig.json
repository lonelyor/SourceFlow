{
  "compilerOptions": {
    "noImplicitAny": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es6",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2021"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "mind-elixir": [
        "./src/types/vendor/mind-elixir"
      ]
    },
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "src/types/dist"
  ]
}
