{
  "name": "SourceFlow",
  "version": "0.1.6",
  "description": "SourceFlow is a local-first personal knowledge workspace.",
  "homepage": "https://github.com/lonelyor/SourceFlow",
  "main": "./electron/main.js",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "lint": "eslint . --fix --cache",
    "dev": "webpack --mode development",
    "dev:mobile": "webpack --mode development --config webpack.mobile.js",
    "dev:desktop": "webpack --mode development --config webpack.desktop.js",
    "dev:export": "webpack --mode development --config webpack.export.js",
    "build": "pnpm run '/build:.*/'",
    "build:app": "webpack --mode production",
    "build:mobile": "webpack --mode production --config webpack.mobile.js",
    "build:desktop": "webpack --mode production --config webpack.desktop.js",
    "build:export": "webpack --mode production --config webpack.export.js",
    "typecheck": "node ./scripts/typecheck.js all",
    "typecheck:app": "node ./scripts/typecheck.js app",
    "typecheck:desktop": "node ./scripts/typecheck.js desktop",
    "typecheck:mobile": "node ./scripts/typecheck.js mobile",
    "typecheck:export": "node ./scripts/typecheck.js export",
    "check:mojibake": "node ./scripts/checkMojibake.js",
    "check:export-guards": "node ./scripts/checkExportGuards.js",
    "check:menu-modularity": "node ./scripts/checkMenuModularity.js",
    "check:protyle-menu-modularity": "node ./scripts/checkProtyleMenuModularity.js",
    "check:gutter-modularity": "node ./scripts/checkGutterModularity.js",
    "check:wysiwyg-modularity": "node ./scripts/checkWysiwygModularity.js",
    "check:keydown-modularity": "node ./scripts/checkKeydownModularity.js",
    "check:av-col-modularity": "node ./scripts/checkAVColModularity.js",
    "check:av-cell-modularity": "node ./scripts/checkAVCellModularity.js",
    "check:av-panel-modularity": "node ./scripts/checkAVPanelModularity.js",
    "check:av-heavy-modularity": "node ./scripts/checkAVHeavyModularity.js",
    "check:av-runtime-modularity": "node ./scripts/checkAVRuntimeModularity.js",
    "check:system-runtime-modularity": "node ./scripts/checkSystemRuntimeModularity.js",
    "check:toolbar-modularity": "node ./scripts/checkToolbarModularity.js",
    "check:transaction-modularity": "node ./scripts/checkTransactionModularity.js",
    "check:script-runtime-guards": "node ./scripts/checkScriptRuntimeGuards.js",
    "test:mojibake": "node ./scripts/checkMojibake.js --self-test",
    "test:startup": "node ./scripts/testElectronStartupFailure.js",
    "test:export-builders": "node ./scripts/testExportBuilders.js",
    "test:homepage-modules": "node ./scripts/testHomepageModules.js",
    "test:plugin-sandbox-runtime": "node ./scripts/testPluginSandboxRuntime.js",
    "test:sandbox-runtime-helpers": "node ./scripts/testSandboxRuntimeHelpers.js",
    "test:structured-data": "node ./scripts/testStructuredDataParser.js",
    "test:av-panel-modules": "node ./scripts/testAVPanelModules.js",
    "test:av-heavy-modules": "node ./scripts/testAVHeavyModules.js",
    "test:av-cell-col-modules": "node ./scripts/testAVCellColModules.js",
    "test:av-cell-coverage": "node ./scripts/testAVCellCoverage.js",
    "test:av-panel-handler-coverage": "node ./scripts/testAVPanelHandlerCoverage.js",
    "test:av-runtime-modules": "node ./scripts/testAVRuntimeModules.js",
    "test:av-runtime-coverage": "node ./scripts/testAVRuntimeCoverage.js",
    "test:system-runtime-modules": "node ./scripts/testSystemRuntimeModules.js",
    "test:ai-dock-runtime": "node ./scripts/testAIDockRuntimeBehavior.js",
    "test:assistant-skill-context": "node ./scripts/testAssistantSkillContext.js",
    "test:assistant-patch-review": "node ./scripts/testAssistantPatchReview.js",
    "test:assistant-ghost-draft": "node ./scripts/testAssistantGhostDraft.js",
    "test:assistant-inline-command": "node ./scripts/testAssistantInlineCommand.js",
    "test:assistant-agent-history": "node ./scripts/testAssistantAgentHistory.js",
    "test:keymap-consistency": "node ./scripts/testKeymapConsistency.js",
    "test:toolbar-inline-mark-modules": "node ./scripts/testToolbarInlineMarkModules.js",
    "test:editor-structure-guide": "node ./scripts/testEditorStructureGuide.js",
    "test:editor-structure-guide-bugfix": "node ./scripts/testStructureGuideBugfix.js",
    "test:export-runtime": "node ./scripts/testExportRuntimeElectron.js",
    "gen:types": "tsc -p tsconfig.types.json",
    "start": "NODE_ENV=development electron ./electron/main.js",
    "dist": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.yml --publish=never",
    "dist-portable": "node ./scripts/distPortable.js",
    "dist-arm64": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --config electron-builder-arm64.yml --publish=never",
    "dist-darwin": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac --config electron-builder-darwin.yml --publish=never",
    "dist-darwin-portable": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac --config electron-builder-darwin-portable.yml --publish=never",
    "dist-darwin-arm64": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --mac --config electron-builder-darwin-arm64.yml --publish=never",
    "dist-darwin-arm64-portable": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --mac --config electron-builder-darwin-arm64-portable.yml --publish=never",
    "dist-linux": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux --config electron-builder-linux.yml --publish=never",
    "dist-linux-portable": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux --config electron-builder-linux-portable.yml --publish=never",
    "dist-linux-arm64": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --linux --config electron-builder-linux-arm64.yml --publish=never",
    "dist-linux-arm64-portable": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --arm64 --linux --config electron-builder-linux-arm64-portable.yml --publish=never"
  },
  "keywords": [
    "markdown",
    "note-taking",
    "notebook"
  ],
  "author": {
    "name": "By lonelyor",
    "url": "https://github.com/lonelyor/SourceFlow"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "@types/node": "^18.13.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "blueimp-md5": "^2.19.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "dayjs": "^1.11.5",
    "electron": "40.8.3",
    "electron-builder": "26.0.12",
    "encoding": "^0.1.13",
    "esbuild-loader": "^3.0.1",
    "eslint": "^9.15.0",
    "file-loader": "^6.2.0",
    "filesize": "^11.0.13",
    "globals": "^15.12.0",
    "html-loader": "^2.1.2",
    "html-webpack-plugin": "^5.5.0",
    "iconv-lite": "^0.6.3",
    "ifdef-loader": "^2.3.2",
    "mini-css-extract-plugin": "2.9.2",
    "path-browserify": "^1.0.1",
    "safer-buffer": "^2.1.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "typescript": "^4.7.4",
    "webpack": "^5.104.1",
    "webpack-bundle-analyzer": "^4.5.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "mind-elixir": "^5.10.0",
    "xterm": "^5.3.0"
  }
}
